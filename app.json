{
  "expo": {
    "name": "Sanalukko",
    "slug": "studylock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A3F8F"
    },
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "bundleIdentifier": "studylock.com.app",
      "appleTeamId": "SL769XQ9JR",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ],
      [
        "react-native-device-activity",
        {
          "appleTeamId": "SL769XQ9JR",
          "appGroup": "group.studylock.com.app"
        }
      ]
    ],
    "android": {
      "package": "studylock.com.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A3F8F"
      }
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "studylock.com.app.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.studylock.com.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "studylock.com.app.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.studylock.com.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "studylock.com.app.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.studylock.com.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "c52bd09b-4177-40e0-8be5-d6cb4b9972ae"
      }
    },
    "owner": "sadek_999"
  }
}
